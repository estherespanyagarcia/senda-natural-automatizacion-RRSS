      "parameters": {
        "jsCode": "// Crea cada slide como carousel item en Instagram y devuelve sus IDs\nconst row = $input.first().json;\nconst slideUrls = Array.isArray(row.carousel_slide_urls)\n  ? row.carousel_slide_urls\n  : JSON.parse(row.carousel_slide_urls);\n\nconst igUserId = '28840447828990358';\nconst token = $vars.INSTAGRAM_TOKEN;\nconst mediaIds = [];\n\nfor (const imageUrl of slideUrls) {\n  const response = await $helpers.httpRequest({\n    method: 'POST',\n    url: `https://graph.instagram.com/v21.0/${igUserId}/media`,\n    headers: {\n      'Authorization': token,\n      'Content-Type': 'application/json'\n    },\n    body: {\n      image_url: imageUrl,\n      is_carousel_item: true\n    }\n  });\n  mediaIds.push(response.id);\n  // Pausa entre requests para respetar rate limits\n  await new Promise(r => setTimeout(r, 2000));\n}\n\nreturn [{\n  json: {\n    mediaIds,\n    carousel_caption: row.carousel_caption,\n    carousel_tema: row.carousel_tema,\n    dia: row.dia\n  }\n}];"
      },
